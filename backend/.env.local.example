# Local overrides example for pokechill-companion (v1)
#
# Copy to `.env.local` (untracked) and fill values.
# Keep real secrets out of committed files.

APP_SECRET=change-me

# Symfony standard database url (used later when Doctrine is added).
DATABASE_URL=postgresql://POKECHILL_DB_USER:POKECHILL_DB_PASSWORD@127.0.0.1:5432/pokechill_companion?serverVersion=16&charset=utf8

# Pokechill source to import reference data (raw URL or local file path).
POKECHILL_SOURCE_URL=https://raw.githubusercontent.com/play-pokechill/play-pokechill.github.io/3db86a50/scripts/pkmnDictionary.js

# Optional overrides (same commit as POKECHILL_SOURCE_URL by default: sibling scripts/).
# POKECHILL_AREAS_SOURCE_URL=https://raw.githubusercontent.com/play-pokechill/play-pokechill.github.io/3db86a50/scripts/areasDictionary.js
# POKECHILL_SHOP_SOURCE_URL=https://raw.githubusercontent.com/play-pokechill/play-pokechill.github.io/3db86a50/scripts/shop.js

