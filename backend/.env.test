# Test environment for PHPUnit / Symfony Kernel tests.
# Copy to `.env.test.local` to override DATABASE_URL (untracked).

APP_ENV=test
APP_DEBUG=false
APP_SECRET=test-secret-change-in-ci

###> doctrine/doctrine-bundle ###
# Base DB name; `when@test` appends `_test` in config/packages/doctrine.yaml (e.g. pokechill_companion_test).
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/pokechill_companion?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###
