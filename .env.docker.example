# Copy to .env next to compose.yaml and adjust values before: docker compose up --build
# Passwords with special characters must be URL-encoded inside DATABASE_URL if you build it manually.
# Here compose builds DATABASE_URL for the php service from the variables below.

POSTGRES_VERSION=16
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=change_this_password

# Symfony (generate e.g. openssl rand -hex 32)
APP_SECRET=change_this_to_a_long_random_string

# FQDN public (même origine pour l’UI et l’API /api/...). DNS + Traefik sur le Pi.
POKECHILL_FQDN=pokechill.example.com

# URL raw du script Pokechill (pkmnDictionary.js) pour app:pokechill:import-reference-data
POKECHILL_SOURCE_URL=https://raw.githubusercontent.com/play-pokechill/play-pokechill.github.io/3db86a50/scripts/pkmnDictionary.js

# Développement local sans Traefik (optionnel) : exposer les ports sur l’hôte.
# UI_HTTP_PORT=8080
# API_HTTP_PORT=8081
